{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "rootDir": "src",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["src/domain/**/*.ts"],
  "exclude": ["node_modules"]
}
